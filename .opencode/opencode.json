  "permission": {
    "*": "ask",
    "doom_loop": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "edit": "ask",
    "kubernetes_kubectl_patch": "ask",
    "kubernetes_exec_in_pod": "ask",
    "kubernetes_kubectl_get": "allow",
    "kubernetes_kubectl_describe": "allow",
    "kubernetes_kubectl_logs": "allow",
    "kubernetes_kubectl_context": "allow",
    "github-personal_get_pull_request_status": "allow",
    "github-personal_create_or_update_file": "ask",
    "github-personal_get_pull_request": "allow",
    "github-personal_get_file_contents": "allow",
    "github-personal_list_commits": "allow",
    "github-personal_get_pull_request_files": "allow",
    "github-personal_search_code": "allow",
    "github-corporate_get_pull_request_status": "allow",
    "github-corporate_create_or_update_file": "ask",
    "github-corporate_get_pull_request": "allow",
    "github-corporate_get_file_contents": "allow",
    "github-corporate_list_commits": "allow",
    "github-corporate_get_pull_request_files": "allow",
    "github-corporate_search_code": "allow",
    "gitlab_get_merge_request": "allow",
    "gitlab_get_merge_request_conflicts": "allow",
    "gitlab_get_merge_request_diffs": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "pwd": "allow",
      "git status *": "allow",
      "git fetch *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git remote *": "allow",
      "git branch *": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "head *": "allow",
      "sleep *": "allow",
      "python -m unittest *": "allow",
      "python -m compileall *": "allow",
      "orca *": "allow",
      "command *": "allow",
      "true": "allow",
      "python3 -m compileall *": "allow",
      "/Users/jorgepulidolopez/Library/Caches/copilot/marketplaces/eugeniughelbur-obsidian-second-brain/hooks/validate-ai-first.sh *": "allow"
    },
    "external_directory": {
      "*": "deny",
      "~/**": "ask"
    },
  },
  "mcp": {
    "github-personal": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token -u jore731) exec npx -y @modelcontextprotocol/server-github"
      ]
    },
    "github-corporate": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token -u PulidoJ_basf) exec npx -y @modelcontextprotocol/server-github"
      ]
    },
    "kubernetes": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-kubernetes"
      ]
    },
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.roqs.basf.net/api/v4/mcp"
    },
    "obsidian": {
      "type": "remote",
      "url": "https://127.0.0.1:27124/mcp",
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_REST_API_KEY}"
      }
    }
  }
